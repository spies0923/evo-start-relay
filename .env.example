# Copy to .env  (chmod 600) — never commit real values.

# Your EvoStart app login (email or phone) + password
EVOSTART_USER=you@example.com
EVOSTART_PASS=your_password

# Your vehicle's terminal id, and your account's command server.
# Both are account-specific — see README "Finding your server, tid & codes".
EVOSTART_TID=00000000000
ZXY_HOST=0.0.0.0
ZXY_PORT=3050

# Local HTTP relay
RELAY_PORT=3300
RELAY_SECRET=change-me-to-a-long-random-string    # gate for /cmd endpoints

# --- Google Smart Home (optional). Must match the Google Home Developer Console. ---
GH_CLIENT_ID=evo-google
GH_CLIENT_SECRET=change-me
GH_LINK_SECRET=change-me            # you type this once, on the relay page, when linking

# --- Advanced: override command/transaction codes if yours differ ---
# Capture your own with `adb logcat` while tapping buttons in the app (see README).
# ZXY_CODE_START=303120
# ZXY_CODE_STOP=303124
# ZXY_CODE_LOCK=303110
# ZXY_CODE_UNLOCK=303115
# ZXY_DISTRIBUTE=evostart
# ZXY_APPVER=1.5.38
